---
interface CardData {
  title: string;
  icon: 'laptop' | 'gamepad' | 'pencil' | 'rocket' | 'link' | 'setting' | 'git';
  delay?: number;
  description: string;
}

interface Props {
  cards: CardData[];
  columns?: 2 | 3;
  featuredIndex?: number;
  layout?: 'grid' | 'zigzag';
}

const { cards, columns = 2, featuredIndex = -1, layout = 'grid' } = Astro.props;
const hasFeatured = featuredIndex >= 0 && featuredIndex < cards.length;
const minCardWidth = columns === 2 ? '300px' : '250px';
const featuredEnabled = layout === 'grid' && hasFeatured;

const iconColors: Record<string, { from: string; to: string }> = {
  laptop: { from: '#0891B2', to: '#22D3EE' },
  gamepad: { from: '#8B5CF6', to: '#EC4899' },
  pencil: { from: '#10B981', to: '#34D399' },
  rocket: { from: '#F97316', to: '#FBBF24' },
  link: { from: '#6366F1', to: '#818CF8' },
  setting: { from: '#0EA5E9', to: '#38BDF8' },
  git: { from: '#64748B', to: '#94A3B8' },
};

const iconPaths: Record<string, string> = {
  laptop: '<rect width="18" height="12" x="3" y="4" rx="2" ry="2"/><line x1="2" x2="22" y1="20" y2="20"/>',
  gamepad: '<line x1="6" x2="10" y1="12" y2="12"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="15" x2="15.01" y1="13" y2="13"/><line x1="18" x2="18.01" y1="11" y2="11"/><rect width="20" height="12" x="2" y="6" rx="2"/>',
  pencil: '<path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/>',
  rocket: '<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>',
  link: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  setting: '<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/>',
  git: '<circle cx="12" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><path d="M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9"/><path d="M12 12v3"/>',
};
---

<div
  class="feature-card-grid"
  data-columns={columns}
  data-layout={layout}
  data-featured-enabled={featuredEnabled ? 'true' : 'false'}
  style={`--card-min: ${minCardWidth};`}
>
  {cards.map((card, index) => {
    const colors = iconColors[card.icon] || iconColors.laptop;
    return (
      <div
        class:list={['feature-card', { 'is-featured': featuredEnabled && index === featuredIndex }]}
        data-card-index={index}
        style={`--delay: ${card.delay ?? 0}ms; --icon-from: ${colors.from}; --icon-to: ${colors.to};`}
      >
        <div class="icon-wrapper">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="white"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={iconPaths[card.icon]}
          />
        </div>
        <h3 class="title">{card.title}</h3>
        <p class="description">{card.description}</p>
      </div>
    );
  })}
</div>

<script is:inline>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const grids = Array.from(document.querySelectorAll('.feature-card-grid'));

  for (const grid of grids) {
    const cards = Array.from(grid.querySelectorAll('.feature-card'));
    if (cards.length === 0) continue;

    if (reduceMotion || typeof IntersectionObserver === 'undefined') {
      for (const card of cards) {
        card.classList.add('is-visible');
      }
      continue;
    }

    grid.setAttribute('data-animate', 'ready');
    for (const [index, card] of cards.entries()) {
      card.style.setProperty('--stagger', `${index * 70}ms`);
    }

    const observer = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          obs.unobserve(entry.target);
        }
      },
      {
        threshold: 0.15,
        rootMargin: '0px 0px -8% 0px',
      }
    );

    for (const card of cards) {
      observer.observe(card);
    }
  }
</script>

<style>
  .feature-card-grid {
    display: grid;
    gap: 1.25rem;
    margin: 1.5rem 0;
    align-items: stretch;
  }

  .feature-card-grid[data-layout='grid'] {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--card-min, 260px)), 1fr));
  }

  .feature-card-grid[data-layout='zigzag'] {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 1024px) {
    .feature-card-grid[data-layout='zigzag'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
      row-gap: 1.25rem;
    }

    .feature-card-grid[data-layout='zigzag'] .feature-card:nth-child(even) {
      --zigzag-offset: 56px;
    }
  }

  @media (min-width: 1024px) {
    .feature-card-grid[data-featured-enabled='true'] .feature-card.is-featured {
      grid-column: span 2;
      min-height: 240px;
      padding: 1.75rem;
    }
  }

  .feature-card {
    position: relative;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.85);
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(226, 232, 240, 0.6);
    cursor: default;
    min-height: 220px;
    --zigzag-offset: 0px;
    transform: translateY(var(--zigzag-offset));
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
    will-change: transform, opacity;
  }

  .feature-card-grid[data-animate='ready'] .feature-card {
    opacity: 0;
    transform: translateY(calc(var(--zigzag-offset) + 16px));
  }

  .feature-card-grid[data-animate='ready'] .feature-card.is-visible {
    opacity: 1;
    transform: translateY(var(--zigzag-offset));
    transition:
      opacity 480ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 480ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 220ms ease,
      border-color 220ms ease;
    transition-delay:
      calc(var(--delay, 0ms) + var(--stagger, 0ms)),
      calc(var(--delay, 0ms) + var(--stagger, 0ms)),
      0ms,
      0ms;
  }

  .feature-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 20%, rgba(255, 255, 255, 0.35) 48%, transparent 76%);
    transform: translateX(-120%);
    opacity: 0;
    transition: transform 240ms ease, opacity 240ms ease;
    pointer-events: none;
  }

  .feature-card:hover {
    transform: translateY(calc(var(--zigzag-offset) - 4px));
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.13);
    border-color: rgba(8, 145, 178, 0.35);
  }

  .feature-card:hover::after {
    opacity: 1;
    transform: translateX(0);
  }

  .feature-card:active {
    transform: translateY(calc(var(--zigzag-offset) - 2px));
  }

  :global([data-theme="dark"]) .feature-card {
    background: rgba(30, 41, 59, 0.85);
    border-color: rgba(51, 65, 85, 0.6);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  :global([data-theme="dark"]) .feature-card:hover {
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.32);
    border-color: rgba(34, 211, 238, 0.35);
  }

  :global([data-theme="dark"]) .feature-card::after {
    background: linear-gradient(115deg, transparent 20%, rgba(148, 163, 184, 0.15) 48%, transparent 76%);
  }

  .icon-wrapper {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--icon-from), var(--icon-to));
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    transition: transform 240ms ease, opacity 300ms ease;
    transform: scale(0.9);
    opacity: 0;
  }

  .feature-card.is-visible .icon-wrapper,
  .feature-card-grid:not([data-animate='ready']) .icon-wrapper {
    opacity: 1;
    transform: scale(1);
    transition-delay: calc(var(--delay, 0ms) + var(--stagger, 0ms) + 80ms);
  }

  .feature-card:hover .icon-wrapper {
    transition-delay: 0ms;
    transform: scale(1.06);
  }

  .title {
    font-size: 1.125rem;
    font-weight: 600;
    color: #164E63;
    margin: 0 0 0.5rem 0;
  }

  :global([data-theme="dark"]) .title {
    color: #ECFEFF;
  }

  .description {
    margin: 0;
    color: #64748b;
    line-height: 1.6;
    font-size: 0.92rem;
  }

  :global([data-theme="dark"]) .description {
    color: #94a3b8;
  }

  @media (hover: none) and (pointer: coarse) {
    .feature-card:hover {
      transform: translateY(var(--zigzag-offset));
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
      border-color: rgba(226, 232, 240, 0.6);
    }

    :global([data-theme='dark']) .feature-card:hover {
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
      border-color: rgba(51, 65, 85, 0.6);
    }

    .feature-card:hover::after {
      opacity: 0;
      transform: translateX(-120%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-card,
    .icon-wrapper,
    .feature-card::after {
      transition: none !important;
      animation: none !important;
    }

    .feature-card {
      transform: translateY(var(--zigzag-offset)) !important;
    }

    .feature-card-grid[data-animate='ready'] .feature-card {
      opacity: 1;
    }
  }
</style>
