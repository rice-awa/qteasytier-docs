---
interface Props {
  title: string;
  icon: string;
  delay?: number;
}

const { title, icon, delay = 0 } = Astro.props;
---

<div 
  class="feature-card group"
  style={`--delay: ${delay}ms`}
>
  <div class="icon-wrapper">
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      {icon === "laptop" && (
        <>
          <rect width="18" height="12" x="3" y="4" rx="2" ry="2"/>
          <line x1="2" x2="22" y1="20" y2="20"/>
        </>
      )}
      {icon === "gamepad" && (
        <>
          <line x1="6" x2="10" y1="12" y2="12"/>
          <line x1="8" x2="8" y1="10" y2="14"/>
          <line x1="15" x2="15.01" y1="13" y2="13"/>
          <line x1="18" x2="18.01" y1="11" y2="11"/>
          <rect width="20" height="12" x="2" y="6" rx="2"/>
        </>
      )}
      {icon === "pencil" && (
        <>
          <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
          <path d="m15 5 4 4"/>
        </>
      )}
      {icon === "rocket" && (
        <>
          <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
          <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
          <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/>
          <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
        </>
      )}
      {icon === "link" && (
        <>
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
        </>
      )}
      {icon === "setting" && (
        <>
          <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
          <circle cx="12" cy="12" r="3"/>
        </>
      )}
      {icon === "git" && (
        <>
          <circle cx="12" cy="18" r="3"/>
          <circle cx="6" cy="6" r="3"/>
          <circle cx="18" cy="6" r="3"/>
          <path d="M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9"/>
          <path d="M12 12v3"/>
        </>
      )}
    </svg>
  </div>
  <h3 class="title">{title}</h3>
  <slot />
</div>

<style>
  .feature-card {
    background: rgba(255, 255, 255, 0.85);
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid rgba(226, 232, 240, 0.6);
    cursor: default;
    opacity: 0;
    transform: translateY(30px);
    animation: cardEnter 0.6s ease-out forwards;
    animation-delay: var(--delay);
  }

  @keyframes cardEnter {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .feature-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
    border-color: rgba(8, 145, 178, 0.3);
  }

  :global([data-theme="dark"]) .feature-card {
    background: rgba(30, 41, 59, 0.85);
    border-color: rgba(51, 65, 85, 0.6);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  :global([data-theme="dark"]) .feature-card:hover {
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
    border-color: rgba(34, 211, 238, 0.3);
  }

  .icon-wrapper {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: linear-gradient(135deg, #0891B2, #22D3EE);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    transition: transform 0.3s ease;
  }

  .feature-card:hover .icon-wrapper {
    transform: scale(1.1) rotate(-3deg);
  }

  .icon {
    width: 24px;
    height: 24px;
    color: white;
  }

  .title {
    font-size: 1.125rem;
    font-weight: 600;
    color: #164E63;
    margin: 0 0 0.5rem 0;
  }

  :global([data-theme="dark"]) .title {
    color: #ECFEFF;
  }

  .feature-card :global(p) {
    margin: 0;
    color: #64748b;
    line-height: 1.6;
    font-size: 0.9rem;
  }

  :global([data-theme="dark"]) .feature-card :global(p) {
    color: #94a3b8;
  }
</style>
